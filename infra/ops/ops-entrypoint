#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  backup)
    exec /usr/local/bin/backup.sh
    ;;
  restore)
    exec /usr/local/bin/restore.sh
    ;;
  retention)
    exec /usr/local/bin/retention.sh
    ;;
  generate-key)
    : "${AGE_IDENTITY_OUTPUT:?AGE_IDENTITY_OUTPUT is required}"
    : "${AGE_RECIPIENT_OUTPUT:?AGE_RECIPIENT_OUTPUT is required}"
    umask 077
    age-keygen -o "${AGE_IDENTITY_OUTPUT}" 2>/dev/null
    age-keygen -y "${AGE_IDENTITY_OUTPUT}" > "${AGE_RECIPIENT_OUTPUT}"
    printf '{"event":"age_key_generated","identity":"mounted-secret","recipient":"public-file"}\n'
    ;;
  *)
    printf 'usage: ops-entrypoint {backup|restore|retention|generate-key}\n' >&2
    exit 64
    ;;
esac
