APP_PORT=8088
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

PODORIA_LOCAL_ADMIN_EMAIL=admin@podoria.local
PODORIA_LOCAL_ADMIN_PASSWORD=replace-with-a-local-development-password

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,proxy
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
DJANGO_COOKIE_SECURE=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_PRELOAD=0
TEMPORARY_PASSWORD_TTL_HOURS=24
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_EMAIL_ATTEMPTS=5
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
CELERY_WORKER_CONCURRENCY=2

POSTGRES_DB=podoria
POSTGRES_USER=podoria
POSTGRES_PASSWORD=replace-with-a-database-password

MINIO_ROOT_USER=podoria_minio
MINIO_ROOT_PASSWORD=replace-with-an-object-storage-password
MINIO_BUCKET_NAME=podoria-private

# Operations placeholders. Production paths must point outside the repository;
# backup target must be mounted from another failure domain.
PODORIA_SECRET_DIR=C:/secure/podoria-production
BACKUP_TARGET_PATH=X:/podoria-off-host-backups
BACKUP_SECRET_DIR=C:/secure/podoria-backup
BACKUP_TARGET_IS_OFFHOST=0
ALLOW_LOCAL_BACKUP_TARGET=0
BACKUP_POSTGRES_USER=podoria_backup
BACKUP_DAILY_KEEP=30
BACKUP_MONTHLY_KEEP=12
