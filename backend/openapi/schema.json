    },
    "components": {
        "schemas": {
            "ChangePasswordRequestRequest": {
                "type": "object",
                "properties": {
                    "new_password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "new_password_confirmation": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "current_password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "current_password",
                    "new_password",
                    "new_password_confirmation"
                ]
            },
            "ContractFixture": {
                "type": "object",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    },
                    "message": {
                        "type": "string"
                    },
                    "correlation_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "correlation_id",
                    "message",
                    "status"
                ]
            },
            "ErrorEnvelope": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "fields": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "correlation_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "correlation_id",
                    "fields",
                    "message"
                ]
            },
            "LoginRequestRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 254
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "PasswordPairRequest": {
                "type": "object",
                "properties": {
                    "new_password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "new_password_confirmation": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "new_password",
                    "new_password_confirmation"
                ]
            },
            "PasswordResetRequestAccepted": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "message"
                ]
            },
            "PasswordResetRequestCreateRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1,
                        "maxLength": 254
                    }
                },
                "required": [
                    "email"
                ]
            },
            "PasswordResetRequestItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "requested_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "user": {
                        "$ref": "#/components/schemas/PasswordResetRequestUser"
                    }
                },
                "required": [
                    "id",
                    "requested_at",
                    "user"
                ]
            },
            "PasswordResetRequestList": {
                "type": "object",
                "properties": {
                    "requests": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PasswordResetRequestItem"
                        }
                    }
                },
                "required": [
                    "requests"
                ]
            },
            "PasswordResetRequestUser": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/RoleEnum"
                    }
                },
                "required": [
                    "display_name",
                    "email",
                    "id",
                    "role"
                ]
            },
            "RoleEnum": {
                "enum": [
                    "podologist",
                    "reception",
                    "admin"
                ],
                "type": "string",
                "description": "* `podologist` - Подолог\n* `reception` - Рецепція\n* `admin` - Адміністратор"
            },
            "Session": {
                "type": "object",
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/SessionUser"
                    },
                    "route_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "must_change_password": {
                        "type": "boolean"
                    },
                    "temporary_password_expires_at": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "temporary_password_expired": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "must_change_password",
                    "route_ids",
                    "temporary_password_expired",
                    "temporary_password_expires_at",
                    "user"
                ]
            },
            "SessionUser": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/RoleEnum"
                    }
                },
                "required": [
                    "display_name",
                    "email",
                    "id",
                    "role"
                ]
            },
            "StatusEnum": {
                "enum": [
                    "ok"
                ],
                "type": "string",
                "description": "* `ok` - ok"
            },
            "TemporaryPasswordRequestRequest": {
                "type": "object",
                "properties": {
                    "temporary_password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    },
                    "temporary_password_confirmation": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "temporary_password",
                    "temporary_password_confirmation"
                ]
            },
            "TemporaryPasswordResult": {
                "type": "object",
                "properties": {
                    "user_id": {
                        "type": "integer"
                    },
                    "must_change_password": {
                        "type": "boolean"
                    },
                    "temporary_password_expires_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "must_change_password",
                    "temporary_password_expires_at",
                    "user_id"
                ]
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "podoria_sessionid"
            }
        }
    }
}