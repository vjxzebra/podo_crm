{
    "openapi": "3.0.3",
    "info": {
        "title": "Podoria CRM API",
        "version": "1.0.0",
        "description": "Versioned API contract for Podoria CRM."
    },
    "paths": {
        "/api/v1/auth/login": {
            "post": {
                "operationId": "auth_login",
                "summary": "Create a server session",
                "tags": [
                    "authentication"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequestRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequestRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequestRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        },
                        "description": ""
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "operationId": "auth_logout",
                "summary": "Destroy the current server session",
                "tags": [
                    "authentication"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/v1/contract/fixture": {
            "get": {
                "operationId": "contract_fixture_retrieve",
                "summary": "Return the technical success or error contract fixture",
                "parameters": [
                    {
                        "in": "query",
                        "name": "outcome",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "error",
                                "success"
                            ],
                            "default": "success"
                        }
                    }
                ],
                "tags": [
                    "platform"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ContractFixture"
                                },
                                "examples": {
                                    "Success": {
                                        "value": {
                                            "status": "ok",
                                            "message": "API contract is available.",
                                            "correlation_id": "tp102-example"
                                        }
                                    }
                                }
                            }
                        },
                        "description": ""
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                },
                                "examples": {
                                    "Error": {
                                        "value": {
                                            "code": "contract_fixture_error",
                                            "message": "Requested the error contract fixture.",
                                            "fields": {
                                                "outcome": [
                                                    "Use success to receive a successful response."
                                                ]
                                            },
                                            "correlation_id": "tp102-example"
                                        }
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/v1/session": {
            "get": {
                "operationId": "session_retrieve",
                "summary": "Return the authenticated user and server-authorized routes",
                "tags": [
                    "authentication"
                ],
                "security": [
                    {
                        "cookieAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Session"
                                }
                            }
                        },
                        "description": ""
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ContractFixture": {
                "type": "object",
                "properties": {
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    },
                    "message": {
                        "type": "string"
                    },
                    "correlation_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "correlation_id",
                    "message",
                    "status"
                ]
            },
            "ErrorEnvelope": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    },
                    "fields": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "correlation_id": {
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "correlation_id",
                    "fields",
                    "message"
                ]
            },
            "LoginRequestRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 254
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true,
                        "minLength": 1
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "RoleEnum": {
                "enum": [
                    "podologist",
                    "reception",
                    "admin"
                ],
                "type": "string",
                "description": "* `podologist` - Подолог\n* `reception` - Рецепція\n* `admin` - Адміністратор"
            },
            "Session": {
                "type": "object",
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/SessionUser"
                    },
                    "route_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "route_ids",
                    "user"
                ]
            },
            "SessionUser": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "display_name": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/RoleEnum"
                    }
                },
                "required": [
                    "display_name",
                    "email",
                    "id",
                    "role"
                ]
            },
            "StatusEnum": {
                "enum": [
                    "ok"
                ],
                "type": "string",
                "description": "* `ok` - ok"
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "podoria_sessionid"
            }
        }
    }
}